# Build outputs (Gradle writes module-level build/ dirs, Kotlin plugin writes .kotlin caches)
build/
.gradle/
.kotlin/
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Gradle wrapper (gradlew, gradlew.bat, gradle-wrapper.jar) is intentionally
# COMMITTED so a fresh clone can run ./gradlew without a local Gradle install.

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
