[TEMPLATE]
# Sprint 4.1 environment template. Copy to `.env` (git-ignored) and fill in.
# NEVER commit the real .env or expose YOUTUBE_API_KEY to the Chrome extension.

# Server-side YouTube Data API v3 key (Google Cloud project, quota ~10,000 units/day)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Dataset store (SQLite; no credentials involved). `:memory:` for ephemeral.
DATABASE_URL=sqlite:///./data/sentiment.db

# --- Acquisition (page size vs dataset limit are DISTINCT settings) ---
# Page size: max results requested per commentThreads.list call.
# YouTube caps a page at 100 items; each page costs 1 quota unit.
MAX_COMMENTS_PER_REQUEST=100
# Dataset limit: max comments intentionally acquired for ONE video per
# acquisition run. Pagination walks nextPageToken until YouTube runs out,
# this limit is reached, or MAX_API_PAGES is reached. Never silently 50.
COMMENT_ACQUISITION_MAX_COMMENTS=5000
# Pagination safety bound against pathological/repeating page tokens.
# Effective ceiling = min(COMMENT_ACQUISITION_MAX_COMMENTS,
# MAX_COMMENTS_PER_REQUEST * MAX_API_PAGES) - raise this for larger caps.
MAX_API_PAGES=100

# Batch size: SQLite write chunks for ingestion AND sentiment read/persist
# batches, so datasets are processed incrementally (never loaded whole).
COMMENT_BATCH_SIZE=500

# --- Sprint 4.3: transient-failure retries (bounded, exponential) ---
# TOTAL attempts per YouTube request (1 = no retry). Only transient errors
# are retried (network, timeout, 5xx, 429); quota/disabled/404/invalid
# payloads never are - retrying those only burns quota. Max 5.
YOUTUBE_RETRY_ATTEMPTS=3
# Base delay for exponential backoff (0.5s -> 1s -> 2s ...). Never logs keys.
YOUTUBE_RETRY_BACKOFF_SECONDS=0.5

# --- Sprint 8: real-time incremental monitoring (§47) ---
# Master switch for the background realtime monitor (off => GET /realtime
# still answers honestly with monitoring=false; no YouTube calls are made).
REALTIME_ENABLED=true
# Monitor cadence; clamped into [MIN, MAX] at the use site so one bad
# value can never spin or starve the loop. Each idle poll costs ~1 YouTube
# quota unit (one newest-first commentThreads page) - raise the interval
# to conserve quota on long sessions.
REALTIME_POLL_INTERVAL_SECONDS=30
REALTIME_MIN_POLL_INTERVAL_SECONDS=15
REALTIME_MAX_POLL_INTERVAL_SECONDS=120
# Sentiment trend noise floor: net-score movement below this many
# percentage points reports STABLE instead of flapping the UI.
REALTIME_TREND_MIN_CHANGE=1.0
# Insight regeneration threshold: audience insight rebuilds only after this
# many NEW polarity verdicts since the last regeneration (never per comment).
REALTIME_INSIGHT_MIN_NEW_ANALYZED=25

# Optional overrides (defaults shown)
DATASET_CACHE_TTL_SECONDS=3600
YOUTUBE_REQUEST_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=128
# Allowed origins (comma-separated). https://www.youtube.com is required:
# the extension's content script fetches from the page origin.
CORS_ORIGINS=chrome-extension://,http://localhost:5173,http://127.0.0.1:5173,https://www.youtube.com
LOG_LEVEL=INFO

# NOTE: background analysis jobs (POST /api/videos/{id}/analysis) run inside
# the backend process; their state lives in the SQLite dataset store, so no
# extra service (Redis/Celery/...) is required. Jobs interrupted by a server
# restart are marked STALE at startup and can simply be retried.
